<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Files Details</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 min-h-screen p-10">

    <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-2xl p-8">

        <!-- Back Button -->
        <a 
            href="/" 
            class="inline-block mb-6 text-blue-500 font-medium hover:underline"
        >
            ← Go Back Home
        </a>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-800 mb-6 break-words">
            <%= filename %>
        </h1>

        <!-- File Content -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
            <p class="text-gray-700 leading-8 whitespace-pre-line">
                <%= filedata %>
            </p>
        </div>

    </div>
    
</body>
</html>